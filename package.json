{
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20",
    "npm": "10.9.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "verify": "npm run lint && npm run knip && npm run typecheck && npm run test:coverage && npm run docs:build",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "biome check packages",
    "lint:fix": "biome check --write packages",
    "format": "biome format --write packages",
    "docs:dev": "npm run docs:dev -w aleatoric-docs",
    "docs:build": "npm run docs:build -w aleatoric-docs",
    "docs:preview": "npm run docs:preview -w aleatoric-docs",
    "playground:build": "npm run build -w aleatoric-playground",
    "knip": "knip",
    "knip:fix": "knip --fix --format --no-progress",
    "lockfile": "npx npm@10.9.2 install"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.7",
    "knip": "^5.46.0",
    "lint-staged": "^16.4.0",
    "typescript": "^5.7",
    "vitest": "^3.0"
  }
}
